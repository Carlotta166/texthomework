# 统一换行符，避免 Windows 与 Linux/macOS 之间来回转换出问题
* text=auto

# shell 脚本必须用 LF，否则在 Git Bash 里会报 bad interpreter: bash^M
*.sh text eol=lf

# Windows 批处理必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不要做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
